# Copy to .env for local runs, or set these in Render. Never commit real values.

# Where the app is reachable, with no trailing slash, e.g. https://juno.onrender.com
PUBLIC_URL=http://localhost:3000

# ElevenLabs: API key (Developers > API keys), the voice Juno uses, Juno's agent ID,
# and the secret shown when you create the post-call webhook.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# A GitHub token for an account with Copilot. Powers Copilot inside the app.
COPILOT_GITHUB_TOKEN=
# Optional: which model Copilot uses. Leave empty for Copilot's default.
COPILOT_MODEL=

# Make.com custom webhook URL (sends the emails).
MAKE_WEBHOOK_URL=

# Inbox that owns the three example businesses.
SEED_OWNER_EMAIL=

# Leave empty to keep data in memory (lost on restart). Render fills this in.
DATABASE_URL=
